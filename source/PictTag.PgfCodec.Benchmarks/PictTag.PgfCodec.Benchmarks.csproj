<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PictTag.PgfCodec\PictTag.PgfCodec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native oracle DLL - the managed-vs-native comparison this benchmark rig exists for (Stage 10,
         new-features/managed-pgf-codec.md), re-declaring the same test-only P/Invoke exports
         PictTag.PgfCodec.Tests.Oracle.NativePgfOracle uses (not referencing that test project - a
         benchmark exe pulling in a test project's dependencies would be backwards). -->
    <None Include="..\..\native\PictTag.PgfDecoder\build\PictTagPgfDecoder.dll"
          Condition="Exists('..\..\native\PictTag.PgfDecoder\build\PictTagPgfDecoder.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="PictTagPgfDecoder.dll" />
  </ItemGroup>

</Project>
