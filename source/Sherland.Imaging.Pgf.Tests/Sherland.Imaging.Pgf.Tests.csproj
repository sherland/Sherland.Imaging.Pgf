<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sherland.Imaging.Pgf.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sherland.Imaging.Pgf\Sherland.Imaging.Pgf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native oracle DLL for the round-trip test rig (new-features/managed-pgf-codec.md) - the
         same SherlandImagingPgfNative.dll PictTag.Data P/Invokes into for production decode, here also
         exercised via its new test-only encode/debug exports (shim.cpp). -->
    <None Include="..\..\native\Sherland.Imaging.Pgf.Native\build\SherlandImagingPgfNative.dll"
          Condition="Exists('..\..\native\Sherland.Imaging.Pgf.Native\build\SherlandImagingPgfNative.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="SherlandImagingPgfNative.dll" />
  </ItemGroup>

</Project>
