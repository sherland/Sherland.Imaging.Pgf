<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sherland.Imaging.Pgf.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sherland.Imaging.Pgf\Sherland.Imaging.Pgf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native oracle library for the round-trip test rig (new-features/managed-pgf-codec.md) - the
         same SherlandImagingPgfNative shim PictTag.Data P/Invokes into for production decode, here also
         exercised via its new test-only encode/debug exports (shim.cpp). LibraryImport("SherlandImagingPgfNative")
         resolves the platform-appropriate filename at load time, so both the Windows .dll and Linux .so
         build outputs are copied (whichever exists on the running platform). -->
    <None Include="..\..\native\Sherland.Imaging.Pgf.Native\build\SherlandImagingPgfNative.dll"
          Condition="Exists('..\..\native\Sherland.Imaging.Pgf.Native\build\SherlandImagingPgfNative.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="SherlandImagingPgfNative.dll" />
    <None Include="..\..\native\Sherland.Imaging.Pgf.Native\build\libSherlandImagingPgfNative.so"
          Condition="Exists('..\..\native\Sherland.Imaging.Pgf.Native\build\libSherlandImagingPgfNative.so')"
          CopyToOutputDirectory="PreserveNewest" Link="libSherlandImagingPgfNative.so" />
  </ItemGroup>

</Project>
